<ui:FluentWindow x:Class="TaskDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:icons="clr-namespace:TaskDesk.Controls" xmlns:behaviors="clr-namespace:TaskDesk.Behaviors" Icon="Assets/Icons/Tally.ico" Title="Tally" Width="1280" Height="800" MinWidth="980" MinHeight="660" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" WindowBackdropType="None" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}" FontFamily="{StaticResource AppFontFamily}" FontSize="14" UseLayoutRounding="True" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing">

  <Grid x:Name="AppRoot" Background="{DynamicResource AppBackground}">

    <Grid x:Name="WindowBackdrop" Background="{Binding Background,ElementName=AppRoot}" IsHitTestVisible="False"/>

    <Grid x:Name="FullLayout">

      <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>

      <ui:TitleBar FontFamily="{StaticResource AppFontFamily}" x:Name="WindowTitle" Title="" Height="48" Padding="6,4,6,4" Foreground="{DynamicResource Ink}" ShowHelp="False">
        <ui:TitleBar.Resources><Style TargetType="ui:TitleBarButton" BasedOn="{StaticResource {x:Type ui:TitleBarButton}}"><Setter Property="Height" Value="48"/></Style></ui:TitleBar.Resources>
        <ui:TitleBar.Header>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <Image Source="Assets/Icons/Tally.png" Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Tally" FontFamily="{StaticResource AppFontFamily}" FontSize="17" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </ui:TitleBar.Header>
        <ui:TitleBar.TrailingContent><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><ui:Button x:Name="EnterMiniButton" Content="Mini 窗口" Click="EnterMiniClick" Style="{StaticResource QuietButton}" FontSize="12" Height="32" Padding="8,4" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="切换到精简待办窗口 (Ctrl+M)" AutomationProperties.Name="切换到 Mini 窗口"/><TextBlock Text="透明度" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryInk}" Margin="0,0,8,0"/><Slider x:Name="OpacitySlider" Style="{StaticResource OpacitySliderStyle}" Width="92" Minimum="50" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" VerticalAlignment="Center" ValueChanged="OpacitySliderChanged" ToolTip="拖动调整窗口透明度；100% 为完全不透明" AutomationProperties.Name="窗口透明度"/><TextBlock x:Name="OpacityValueText" Text="100%" Width="32" Margin="6,0,14,0" FontSize="11" VerticalAlignment="Center" TextAlignment="Left" Foreground="{DynamicResource SecondaryInk}"/><TextBlock Text="主题" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0" Foreground="{DynamicResource SecondaryInk}"/><ComboBox x:Name="ThemePicker" SelectedValuePath="Key" SelectionChanged="ThemeSelectionChanged" Width="120" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" Padding="8,4" FontSize="11" ToolTip="切换界面主题" AutomationProperties.Name="界面主题"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextAlignment="Center" HorizontalAlignment="Stretch"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></ui:TitleBar.TrailingContent>
      </ui:TitleBar>


      <Grid Grid.Row="1" Margin="20,8,20,12">

        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" MinWidth="320" /><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Width" Value="18"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Width" Value="300"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition></Grid.ColumnDefinitions>

        <Grid>

        <Border x:Name="SidebarSurface" Background="{DynamicResource SidebarFill}" Style="{StaticResource GlassPane}">

            <DockPanel LastChildFill="True" Margin="16,22,16,14">

              <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" Margin="8,4"><Ellipse Width="6" Height="6" Fill="#89AC9C" Margin="0,0,8,0" /><ui:Button Content="数据文件夹" Command="{Binding OpenDataFolderCommand}" ToolTip="{Binding DataPath}" Style="{StaticResource QuietButton}" Padding="0" FontSize="11" /></StackPanel></StackPanel>

              <ScrollViewer x:Name="SidebarScroll" Margin="0,0,-12,0" behaviors:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,0">

                <ui:Button x:Name="AddTaskNavigation" Click="OpenTaskComposer" ToolTip="添加任务 (Ctrl+N)" AutomationProperties.Name="添加任务">
                  <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsAddingTask}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/><Setter Property="MouseOverBackground" Value="{DynamicResource AccentHover}"/></DataTrigger></Style.Triggers></Style></ui:Button.Style>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:FontIcon FontFamily="{x:Static icons:AppIcons.Family}" Glyph="{x:Static icons:AppIcons.Add}" FontSize="18"/><TextBlock Grid.Column="1" Text="添加任务" VerticalAlignment="Center"/></Grid>
                </ui:Button>
                <TextBlock Text="任务状态" FontSize="11" Foreground="{DynamicResource SecondaryInk}" Margin="14,16,0,6"/>
                <ItemsControl ItemsSource="{Binding StateNavigation}" ItemTemplate="{StaticResource NavTemplate}" />
                <TextBlock Text="时间" ToolTip="按创建日期查看；近一周为最近 7 天，近一月为最近 30 天，均包含今天" FontSize="11" Foreground="{DynamicResource SecondaryInk}" Margin="14,18,0,8"/>
                <ItemsControl ItemsSource="{Binding TimeNavigation}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                  <ui:Button Content="{Binding Title}" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                    <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource NavButton}"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,8"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Margin" Value="2,2"/></Style></ui:Button.Style>
                  </ui:Button>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                <TextBlock Text="清单" ToolTip="右键点击清单可重命名" FontSize="11" Foreground="{DynamicResource SecondaryInk}" Margin="14,30,0,10" />

                <ItemsControl ItemsSource="{Binding CustomLists}">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid>
                      <ui:Button Style="{StaticResource NavButton}" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                        <ui:Button.ContextMenu><ContextMenu FontFamily="{StaticResource AppFontFamily}"><MenuItem Header="重命名清单…" Click="RenameListClick"/></ContextMenu></ui:Button.ContextMenu><Grid Margin="0,0,24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <ui:FontIcon FontFamily="{x:Static icons:AppIcons.Family}" Glyph="{Binding Icon}" FontSize="18" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                          <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" Opacity=".65" VerticalAlignment="Center" Margin="3,0,0,0" />
                        </Grid>
                      </ui:Button>
                      <ui:Button Icon="{icons:Iconfont Delete,Size=14}" Style="{StaticResource QuietButton}" Padding="4" Width="24" Height="28" Margin="0,0,7,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="DeleteListClick" ToolTip="删除清单（任务会保留）" AutomationProperties.Name="{Binding Title,StringFormat=删除清单：{0}}" />
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource CompactQuickAddPane}" Margin="0,18,0,8">

                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                    <ui:FontIcon FontFamily="{x:Static icons:AppIcons.Family}" Glyph="{x:Static icons:AppIcons.Add}" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" />

                    <ui:TextBox Grid.Column="1" Text="{Binding NewListName,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="新清单名称" FontSize="12" Padding="3,6" MinWidth="0" MaxLength="24" Style="{StaticResource InlineGlassInput}" AutomationProperties.Name="新清单名称">

                      <ui:TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddListCommand}" /></ui:TextBox.InputBindings>

                    </ui:TextBox>

                    <ui:Button Grid.Column="2" Content="添加" Command="{Binding AddListCommand}" Style="{StaticResource CompactAddButton}" Margin="3,0,0,0" ToolTip="创建清单" AutomationProperties.Name="创建清单" />

                  </Grid>

                </Border>

              </StackPanel></ScrollViewer>

            </DockPanel>

        </Border>

        </Grid>

        <Grid Grid.Column="2" Margin="4,10,4,12" Visibility="{Binding IsAddingTask,Converter={StaticResource InverseVisibility}}">

          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

          <Grid Margin="3,0,3,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ViewTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ViewTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="{Binding DateLabel}" FontSize="12" Foreground="{DynamicResource SecondaryInk}"/></StackPanel></Grid>

          <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="125" /></Grid.ColumnDefinitions><ui:TextBox x:Name="SearchBox" ToolTip="搜索当前视图；无结果时可搜索全部任务" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索当前视图的任务或备注…" Icon="{icons:Iconfont Search}" Style="{StaticResource GlassInput}" AutomationProperties.Name="搜索任务" /><ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}"  VerticalContentAlignment="Center" AutomationProperties.Name="排序方式" FontSize="12" /></Grid>

          <StackPanel Grid.Row="3" Margin="3,0,3,8">

            <Grid><TextBlock Text="{Binding CountLabel}" FontSize="11" Foreground="{DynamicResource SecondaryInk}" /><TextBlock Text="{Binding DateScopeLabel}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource SecondaryInk}" /></Grid>

          </StackPanel>

          <Grid Grid.Row="4">

            <ui:ListView x:Name="TaskList" behaviors:SmoothScroll.IsEnabled="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page" ScrollViewer.CanContentScroll="True" SelectionMode="Single" ItemsSource="{Binding TasksView}" SelectedItem="{Binding SelectedTask,Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" AutomationProperties.Name="任务列表">

              <ui:ListView.Resources><SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" /><SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="Transparent" /></ui:ListView.Resources>

              <ui:ListView.GroupStyle>

                <GroupStyle>

                  <GroupStyle.ContainerStyle>

                    <Style TargetType="GroupItem">

                      <Setter Property="Margin" Value="0,0,0,8" />

                      <Setter Property="VerticalAlignment" Value="Top" />

                      <Setter Property="Template">

                        <Setter.Value>

                          <ControlTemplate TargetType="GroupItem">

                            <Expander Style="{StaticResource TaskDateExpander}" IsExpanded="{Binding Name.IsExpanded,Mode=TwoWay}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">

                              <Expander.Header><StackPanel Orientation="Horizontal" Margin="0"><TextBlock Text="{Binding Name.Label}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding ItemCount,StringFormat={}（{0} 项）}" FontSize="11" Foreground="{DynamicResource SecondaryInk}" Margin="5,0,0,0" VerticalAlignment="Center" /></StackPanel></Expander.Header>

                              <ItemsPresenter Margin="0,6,0,0" />

                            </Expander>

                          </ControlTemplate>

                        </Setter.Value>

                      </Setter>

                    </Style>

                  </GroupStyle.ContainerStyle>

                </GroupStyle>

              </ui:ListView.GroupStyle>

              <ui:ListView.ItemContainerStyle><Style TargetType="ui:ListViewItem" BasedOn="{StaticResource {x:Type ui:ListViewItem}}"><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Border.CornerRadius" Value="18" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style></ui:ListView.ItemContainerStyle>

              <ui:ListView.ItemTemplate><DataTemplate>
                <Border CornerRadius="18" BorderThickness="1.5" Padding="15,13" MinHeight="77">
                  <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource GlassFill}"/><Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ui:ListViewItem}}" Value="True"><Setter Property="Background" Value="{DynamicResource TaskSelectionFill}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox FontFamily="{StaticResource AppFontFamily}" IsChecked="{Binding IsCompleted,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="完成或恢复任务" AutomationProperties.Name="{Binding Title,StringFormat=完成或恢复任务：{0}}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Opacity" Value="0.55"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Ink}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      <WrapPanel Margin="0,7,0,0">
                        <Border CornerRadius="5" Padding="6,2" Margin="0,0,6,4">
                          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#16707886"/><Style.Triggers><DataTrigger Binding="{Binding Priority}" Value="0"><Setter Property="Background" Value="#30D64848"/></DataTrigger><DataTrigger Binding="{Binding Priority}" Value="1"><Setter Property="Background" Value="#25D69435"/></DataTrigger><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Background" Value="#16707886"/></DataTrigger></Style.Triggers></Style></Border.Style>
                          <TextBlock Text="{Binding PriorityLabel}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#59616B"/><Style.Triggers><DataTrigger Binding="{Binding Priority}" Value="0"><Setter Property="Foreground" Value="#A52C35"/></DataTrigger><DataTrigger Binding="{Binding Priority}" Value="1"><Setter Property="Foreground" Value="#875710"/></DataTrigger><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Foreground" Value="#59616B"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Border>
                        <Border CornerRadius="5" Padding="6,2" Margin="0,0,6,4" Visibility="{Binding HasDueDate,Converter={StaticResource BoolVisibility}}" ToolTip="{Binding DueDate,StringFormat=截止日期：{0:yyyy年M月d日}}">
                          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#12707886"/><Style.Triggers><DataTrigger Binding="{Binding IsDueToday}" Value="True"><Setter Property="Background" Value="#30D69435"/></DataTrigger><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Background" Value="#30D64848"/></DataTrigger></Style.Triggers></Style></Border.Style>
                          <TextBlock Text="{Binding DueLabel}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#59616B"/><Style.Triggers><DataTrigger Binding="{Binding IsDueToday}" Value="True"><Setter Property="Foreground" Value="#875710"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#A52C35"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Border>
                      </WrapPanel>
                      <TextBlock Text="{Binding ListSummary}" FontSize="11" Foreground="{DynamicResource SecondaryInk}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:Button Grid.Column="2" Icon="{icons:Iconfont Delete,Size=18}" Command="{Binding DataContext.DeleteTaskCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="#C54545" Style="{StaticResource QuietButton}" ToolTip="删除任务" AutomationProperties.Name="删除任务"/>
                  </Grid>
                </Border>
              </DataTemplate></ui:ListView.ItemTemplate>

            </ui:ListView>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330" Visibility="{Binding HasTasks,Converter={StaticResource InverseVisibility}}">
              <ui:FontIcon FontFamily="{x:Static icons:AppIcons.Family}" Glyph="{x:Static icons:AppIcons.Completed}" FontSize="40" Foreground="#8F98A2"/>
              <TextBlock Text="{Binding EmptyTitle}" Margin="0,16,0,7" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding EmptyHint}" FontSize="12" Foreground="{DynamicResource SecondaryInk}" TextWrapping="Wrap" TextAlignment="Center"/>
              <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0"><ui:Button Content="清除搜索" Command="{Binding ClearSearchCommand}" Visibility="{Binding HasSearch,Converter={StaticResource BoolVisibility}}" Style="{StaticResource QuietButton}"/><ui:Button Content="搜索全部任务" Command="{Binding SearchAllCommand}" Visibility="{Binding HasSearch,Converter={StaticResource BoolVisibility}}" Style="{StaticResource QuietButton}"/></WrapPanel>
            </StackPanel>

          </Grid>

          <StackPanel Grid.Row="5" Margin="3,10,3,0"><Grid><TextBlock Text="当前清单进度" FontSize="11" Foreground="{DynamicResource SecondaryInk}" /><TextBlock Text="{Binding ProgressLabel}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource SecondaryInk}" /></Grid><ProgressBar Value="{Binding Progress,Mode=OneWay}" Maximum="100" Height="5" Margin="0,9,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressTrack}" BorderThickness="0" /></StackPanel>

        </Grid>

        <Grid x:Name="NewTaskForm" Grid.Column="2" Grid.ColumnSpan="3" Margin="4,10,4,12" Visibility="{Binding IsAddingTask,Converter={StaticResource BoolVisibility}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="3,0,3,18"><TextBlock Text="添加任务" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="先记下要做的事，其他信息可以稍后补充" FontSize="12" Foreground="{DynamicResource SecondaryInk}" Margin="0,8,0,0"/></StackPanel>
          <Border Grid.Row="1" Style="{StaticResource GlassPane}" x:Name="NewTaskSurface" HorizontalAlignment="Stretch">
            <DockPanel Margin="24">
              <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Enter 添加 · Esc 返回" FontSize="11" Foreground="{DynamicResource SecondaryInk}" VerticalAlignment="Center"/><ui:Button Grid.Column="1" Content="取消" Click="CancelTaskComposer" Style="{StaticResource QuietButton}" Margin="0,0,10,0"/><ui:Button Grid.Column="2" Content="添加任务" Click="SubmitNewTask" Style="{StaticResource PrimaryGlassButton}" AutomationProperties.Name="确认添加任务"/></Grid>
              <ScrollViewer behaviors:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                  <TextBlock Text="任务内容" FontSize="13" Margin="2,0,0,10"/>
                  <ui:TextBox x:Name="NewTaskBox" Text="{Binding NewTitle,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="准备做什么？" FontSize="18" Padding="12" MaxLength="100" Style="{StaticResource GlassInput}" PreviewKeyDown="NewTaskTitleKeyDown" AutomationProperties.Name="新任务标题"/>
                  <TextBlock Text="{Binding NewTaskFeedback}" Style="{StaticResource ValidationMessage}"/>
                  <TextBlock Text="备注（选填）" Style="{StaticResource FieldLabel}"/>
                  <ui:TextBox Text="{Binding NewTaskNotes,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="补充需要记住的细节" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90" MaxLength="4000" VerticalScrollBarVisibility="Auto" Style="{StaticResource GlassInput}" AutomationProperties.Name="新任务备注"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="截止日期（选填）" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><DatePicker x:Name="NewTaskDatePicker" SelectedDate="{Binding NewTaskDate}" AutomationProperties.Name="新任务截止日期" DateValidationError="DateValidationError" SelectedDateChanged="DateSelectionChanged"/><ui:Button Grid.Column="1" Icon="{icons:Iconfont Close}" Click="ClearNewTaskDate" Style="{StaticResource QuietButton}" ToolTip="清除截止日期" AutomationProperties.Name="清除新任务截止日期"/></Grid></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="优先级" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PriorityOptions}" SelectedIndex="{Binding NewTaskPriority}" AutomationProperties.Name="新任务优先级"/></StackPanel>
                  </Grid>
                  <TextBlock x:Name="NewTaskDateFeedback" Style="{StaticResource ValidationMessage}"/>
                  <TextBlock Text="所属清单" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Lists}" SelectedItem="{Binding NewTaskList}" AutomationProperties.Name="新任务所属清单"/>
                  <TextBlock Text="子任务（选填）" Style="{StaticResource FieldLabel}"/>
                  <ItemsControl ItemsSource="{Binding NewTaskSteps}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,6"><ui:Button DockPanel.Dock="Right" Icon="{icons:Iconfont Delete,Size=14}" Foreground="#C54545" Style="{StaticResource QuietButton}" Command="{Binding DataContext.RemoveNewTaskStepCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="移除子任务"/><TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:TextBox Text="{Binding NewTaskStepTitle,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="添加一个小步骤…" MaxLength="80" Style="{StaticResource GlassInput}"><ui:TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddNewTaskStepCommand}"/></ui:TextBox.InputBindings></ui:TextBox><ui:Button Grid.Column="1" Content="添加子任务" Command="{Binding AddNewTaskStepCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/></Grid>

                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>

        <Grid Grid.Column="4" Visibility="{Binding HasSelection,Converter={StaticResource BoolVisibility}}">

        <Border Style="{StaticResource GlassPane}">

          <Grid Margin="19,20">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSelection,Converter={StaticResource InverseVisibility}}"><ui:FontIcon FontFamily="{x:Static icons:AppIcons.Family}" Glyph="{x:Static icons:AppIcons.List}" FontSize="35" Foreground="#9A97AE" /><TextBlock Text="未选择任务" Margin="0,14,0,5" HorizontalAlignment="Center" /><TextBlock Text="点击任务查看详情" FontSize="12" Foreground="{DynamicResource SecondaryInk}" /></StackPanel>

            <DockPanel Visibility="{Binding HasSelection,Converter={StaticResource BoolVisibility}}">

              <Grid DockPanel.Dock="Top" Margin="2,0,0,14"><TextBlock Text="任务详情" FontSize="12" Foreground="{DynamicResource SecondaryInk}" VerticalAlignment="Center" /><ui:Button Icon="{icons:Iconfont Close}" Command="{Binding CloseDetailsCommand}" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" ToolTip="关闭详情 (Esc)" AutomationProperties.Name="关闭详情" /></Grid>

              <Grid DockPanel.Dock="Bottom" Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ui:Button Content="删除任务" Command="{Binding DeleteTaskCommand}" Foreground="#A05D65" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" /><ui:Button Grid.Column="1" Content="立即保存 / 重试" Command="{Binding SaveCommand}" Style="{StaticResource QuietButton}" ToolTip="修改会自动保存，也可在此立即保存或重试" /></Grid>

              <ScrollViewer x:Name="DetailsScroll" Margin="0,0,-12,0" behaviors:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,17,0">
                <TextBlock Text="{Binding SaveState}" FontSize="11" Foreground="{DynamicResource SecondaryInk}" Margin="2,0,0,10" TextWrapping="Wrap"/>

                <ui:TextBox Text="{Binding EditTitle,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False" FontSize="18" FontWeight="SemiBold" Style="{StaticResource GlassInput}" Padding="10" MaxLength="100" AutomationProperties.Name="任务标题" AutomationProperties.HelpText="{Binding TitleFeedback}" />

                <TextBlock Text="{Binding TitleFeedback}" Style="{StaticResource ValidationMessage}" Visibility="{Binding HasTitleFeedback,Converter={StaticResource BoolVisibility}}" />

                <StackPanel Margin="2,8,0,0"><TextBlock Text="{Binding SelectedTask.CreatedTimeLabel}" FontSize="11" Foreground="{DynamicResource SecondaryInk}" /><TextBlock Text="{Binding SelectedTask.CompletedTimeLabel}" FontSize="11" Foreground="{DynamicResource SecondaryInk}" Margin="0,4,0,0" Visibility="{Binding SelectedTask.IsCompleted,Converter={StaticResource BoolVisibility}}" /></StackPanel>

                <TextBlock Text="所属清单" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="TaskListPicker" ItemsSource="{Binding Lists}" SelectedItem="{Binding EditList}"  Padding="10,8" AutomationProperties.Name="所属清单" />

                <TextBlock Text="截止日期" Style="{StaticResource FieldLabel}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions><DatePicker x:Name="DueDatePicker" DateValidationError="DateValidationError" SelectedDateChanged="DateSelectionChanged" SelectedDate="{Binding EditDate}" SelectedDateFormat="Short"  Padding="7" AutomationProperties.Name="截止日期" /><ui:Button Grid.Column="1" Icon="{icons:Iconfont Close}" Command="{Binding ClearDateCommand}" Click="ClearDueDateFeedback" Style="{StaticResource QuietButton}" ToolTip="清除截止日期" AutomationProperties.Name="清除截止日期" /></Grid>

                <TextBlock x:Name="DueDateFeedback" Style="{StaticResource ValidationMessage}" />

                <TextBlock Text="优先级" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding PriorityOptions}" SelectedIndex="{Binding EditPriority}"  Padding="10,8" AutomationProperties.Name="优先级" />


                <Grid Margin="2,23,0,9"><TextBlock Text="子任务步骤" FontSize="12" /><TextBlock Text="{Binding SelectedTask.StepsSummary}" FontSize="11" Foreground="{DynamicResource SecondaryInk}" HorizontalAlignment="Right" /></Grid>

                <ItemsControl ItemsSource="{Binding SelectedTask.Steps}">

                  <ItemsControl.ItemTemplate><DataTemplate>

                    <Grid Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                      <CheckBox FontFamily="{StaticResource AppFontFamily}" IsChecked="{Binding IsCompleted,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" Margin="0,3,6,3" AutomationProperties.Name="{Binding Title}">

                        <CheckBox.ContextMenu><ContextMenu FontFamily="{StaticResource AppFontFamily}"><MenuItem Header="重命名步骤…" Click="RenameStepClick"/></ContextMenu></CheckBox.ContextMenu><TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" ToolTip="右键可重命名步骤"/>

                      </CheckBox>

                      <ui:Button Grid.Column="1" Icon="{icons:Iconfont Delete}" Command="{Binding DataContext.DeleteStepCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="6" VerticalAlignment="Center" ToolTip="删除步骤" AutomationProperties.Name="{Binding Title,StringFormat=删除步骤：{0}}" />

                    </Grid>

                  </DataTemplate></ItemsControl.ItemTemplate>

                </ItemsControl>

                <Border Style="{StaticResource CompactQuickAddPane}" Margin="0,8,0,0">

                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                    <ui:FontIcon FontFamily="{x:Static icons:AppIcons.Family}" Glyph="{x:Static icons:AppIcons.Add}" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" />

                    <ui:TextBox Grid.Column="1" Text="{Binding NewStepTitle,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="添加一个步骤" FontSize="12" Padding="3,6" MinWidth="0" MaxLength="80" Style="{StaticResource InlineGlassInput}" AutomationProperties.Name="新步骤">

                      <ui:TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddStepCommand}" /></ui:TextBox.InputBindings>

                    </ui:TextBox>

                    <ui:Button Grid.Column="2" Content="添加" Command="{Binding AddStepCommand}" Style="{StaticResource CompactAddButton}" Margin="3,0,0,0" ToolTip="添加步骤" AutomationProperties.Name="添加步骤" />

                  </Grid>

                </Border>

                <TextBlock Text="备注" Style="{StaticResource FieldLabel}" /><ui:TextBox Text="{Binding EditNotes,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="补充任务的细节…" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" MaxLength="4000" VerticalScrollBarVisibility="Auto" Style="{StaticResource GlassInput}" FontSize="12" AutomationProperties.Name="任务备注" />

              </StackPanel></ScrollViewer>

            </DockPanel>

          </Grid>

        </Border>

        </Grid>

      </Grid>

      <Grid Grid.Row="2" Margin="30,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource SecondaryInk}" TextTrimming="CharacterEllipsis" MaxWidth="480" VerticalAlignment="Center" ToolTip="{Binding Status}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding SaveState}" ToolTip="{Binding DataPath}" FontSize="11" Foreground="{DynamicResource SecondaryInk}" Margin="0,0,20,0" /><TextBlock Text="Ctrl+N 新建  ·  Ctrl+K 搜索" FontSize="11" Foreground="{DynamicResource SecondaryInk}" /></StackPanel></Grid>

    </Grid>


    <Grid x:Name="MiniLayout" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
      <ui:TitleBar FontFamily="{StaticResource AppFontFamily}" x:Name="MiniTitle" Title="" Height="40" Padding="6,4,6,4" FontSize="12" ShowMaximize="False" CanMaximize="False" ShowHelp="False">
        <ui:TitleBar.Resources><Style TargetType="ui:TitleBarButton" BasedOn="{StaticResource {x:Type ui:TitleBarButton}}"><Setter Property="Height" Value="40"/></Style></ui:TitleBar.Resources>
        <ui:TitleBar.Header><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="MiniLogo" Source="Assets/Icons/Tally.png" Width="20" Height="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Tally Mini" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></ui:TitleBar.Header>
        <ui:TitleBar.TrailingContent><Grid Margin="0,0,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:Button x:Name="MiniThemeButton" Click="ToggleThemeClick" Content="暖白" Style="{StaticResource QuietButton}" FontSize="10.5" Padding="5,4" Margin="0,0,2,0" AutomationProperties.Name="切换 Mini 主题"/><ui:Button Grid.Column="1" x:Name="MiniOpacityButton" Content="100%" Click="OpenOpacityPopup" Style="{StaticResource QuietButton}" FontSize="10.5" Padding="5,4" MinWidth="42" ToolTip="调节窗口透明度" AutomationProperties.Name="Mini 透明度"/>
          <Popup x:Name="MiniOpacityPopup" PlacementTarget="{Binding ElementName=MiniOpacityButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="{DynamicResource PaneFill}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,4,0,0"><StackPanel><TextBlock Text="窗口透明度" FontSize="12" Foreground="{DynamicResource Ink}"/><Slider x:Name="MiniOpacitySlider" Style="{StaticResource OpacitySliderStyle}" Width="160" Minimum="50" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" Margin="0,12,0,8" ValueChanged="OpacitySliderChanged" AutomationProperties.Name="Mini 窗口透明度滑块"/><TextBlock Text="50% 半透明 · 100% 不透明" FontSize="10.5" Foreground="{DynamicResource SecondaryInk}"/></StackPanel></Border></Popup>
        </Grid></ui:TitleBar.TrailingContent>
      </ui:TitleBar>
      <Grid Grid.Row="1" Margin="12,2,12,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="MiniScopePicker" ItemsSource="{Binding MiniScopes}" DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding MiniScopeKey,Mode=TwoWay}" FontSize="12" Padding="8,6" MinWidth="80" AutomationProperties.Name="Mini 任务清单"/>
        <CheckBox FontFamily="{StaticResource AppFontFamily}" Grid.Column="1" Content="置顶" IsChecked="{Binding Topmost,RelativeSource={RelativeSource AncestorType=Window},Mode=TwoWay}" VerticalAlignment="Center" Margin="10,0,5,0" FontSize="11" ToolTip="让 Mini 窗口保持在其他窗口上方" AutomationProperties.Name="Mini 窗口置顶"/>
        <ui:Button Grid.Column="2" Content="展开" Click="ExitMiniClick" Style="{StaticResource QuietButton}" FontSize="11" Padding="6" ToolTip="返回完整窗口 (Ctrl+M / Esc)" AutomationProperties.Name="返回完整窗口"/>
      </Grid>
      <Border Grid.Row="2" Margin="12,0,12,9" Style="{StaticResource CompactQuickAddPane}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ui:TextBox x:Name="MiniNewTaskBox" Text="{Binding MiniNewTitle,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="输入后 Enter 快记…" MaxLength="100" FontSize="12" Padding="5,6" Style="{StaticResource InlineGlassInput}" AutomationProperties.Name="Mini 新任务内容"><ui:TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddMiniTaskCommand}"/></ui:TextBox.InputBindings></ui:TextBox>
          <ui:Button Grid.Column="1" Icon="{icons:Iconfont Add,Size=15}" Click="OpenMiniTaskEditor" Style="{StaticResource CompactAddButton}" Padding="7,5" ToolTip="详细添加任务；输入后按 Enter 可快速添加" AutomationProperties.Name="Mini 添加任务"/>
        </Grid>
      </Border>
      <Grid Grid.Row="3" Margin="10,0,10,0">
        <ui:ListView x:Name="MiniTaskList" ItemsSource="{Binding MiniTasksView}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" behaviors:SmoothScroll.IsEnabled="True" AutomationProperties.Name="Mini 任务">
          <ui:ListView.ItemContainerStyle><Style TargetType="ui:ListViewItem" BasedOn="{StaticResource {x:Type ui:ListViewItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Border.CornerRadius" Value="12"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style></ui:ListView.ItemContainerStyle>
          <ui:ListView.ItemTemplate><DataTemplate>
            <Border CornerRadius="12" Background="{DynamicResource GlassFill}" Padding="10,9" BorderThickness="1" BorderBrush="{DynamicResource GlassEdge}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox FontFamily="{StaticResource AppFontFamily}" IsChecked="{Binding IsCompleted,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="勾选完成，再次点击可取消" AutomationProperties.Name="{Binding Title,StringFormat=Mini 任务：{0}}"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" MouseLeftButtonUp="EditMiniTask" Cursor="Hand" ToolTip="点击编辑任务详情"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="{DynamicResource SecondaryInk}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                  <TextBlock Text="已完成" FontSize="10.5" Foreground="{DynamicResource SecondaryInk}" Margin="0,5,0,0" Visibility="{Binding IsCompleted,Converter={StaticResource BoolVisibility}}"/>
                  <WrapPanel Margin="0,5,0,0" Visibility="{Binding IsCompleted,Converter={StaticResource InverseVisibility}}">
                    <Border CornerRadius="4" Padding="5,2" Margin="0,0,5,2">
                      <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#16707886"/><Style.Triggers><DataTrigger Binding="{Binding Priority}" Value="0"><Setter Property="Background" Value="#30D64848"/></DataTrigger><DataTrigger Binding="{Binding Priority}" Value="1"><Setter Property="Background" Value="#25D69435"/></DataTrigger></Style.Triggers></Style></Border.Style>
                      <TextBlock Text="{Binding PriorityLabel}" FontSize="10.5"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#59616B"/><Style.Triggers><DataTrigger Binding="{Binding Priority}" Value="0"><Setter Property="Foreground" Value="#A52C35"/></DataTrigger><DataTrigger Binding="{Binding Priority}" Value="1"><Setter Property="Foreground" Value="#875710"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Border>
                    <Border CornerRadius="4" Padding="5,2" Margin="0,0,0,2" Visibility="{Binding HasDueDate,Converter={StaticResource BoolVisibility}}" ToolTip="{Binding DueDate,StringFormat=截止日期：{0:yyyy年M月d日}}">
                      <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#12707886"/><Style.Triggers><DataTrigger Binding="{Binding IsDueToday}" Value="True"><Setter Property="Background" Value="#30D69435"/></DataTrigger><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Background" Value="#30D64848"/></DataTrigger></Style.Triggers></Style></Border.Style>
                      <TextBlock Text="{Binding DueLabel}" FontSize="10.5"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#59616B"/><Style.Triggers><DataTrigger Binding="{Binding IsDueToday}" Value="True"><Setter Property="Foreground" Value="#875710"/></DataTrigger><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#A52C35"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Border>
                  </WrapPanel>
                </StackPanel>
                <ui:Button Grid.Column="2" Icon="{icons:Iconfont Delete,Size=14}" Command="{Binding DataContext.DeleteTaskCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#C54545" Style="{StaticResource QuietButton}" Padding="5" Margin="4,0,0,0" ToolTip="删除任务" AutomationProperties.Name="Mini 删除任务"/>
              </Grid>
            </Border>
          </DataTemplate></ui:ListView.ItemTemplate>
        </ui:ListView>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15" Visibility="{Binding MiniHasTasks,Converter={StaticResource InverseVisibility}}"><TextBlock Text="还没有任务" HorizontalAlignment="Center" FontSize="14"/><TextBlock Text="{Binding MiniEmptyHint}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryInk}" Margin="0,8,0,0"/></StackPanel>
      </Grid>
      <Grid Grid.Row="4" Margin="14,0,14,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MiniCountLabel}" FontSize="10.5" Foreground="{DynamicResource SecondaryInk}" VerticalAlignment="Center"/><ui:Button Grid.Column="2" Content="{Binding SaveState}" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" FontSize="10.5" Padding="3,0" ToolTip="自动保存；点击可立即保存或重试" AutomationProperties.Name="Mini 保存或重试"/></Grid>
    </Grid>
  </Grid>

</ui:FluentWindow>
