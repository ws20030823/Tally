<ui:FluentWindow x:Class="TaskDesk.Controls.TaskEditorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:icons="clr-namespace:TaskDesk.Controls" Title="任务详情" Width="440" Height="650" MinWidth="360" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}" FontFamily="{StaticResource AppFontFamily}">
<Grid Background="{DynamicResource AppBackground}"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ui:TitleBar x:Name="EditorTitle" Title="任务详情" Height="40" ShowMaximize="False" ShowMinimize="False" CanMaximize="False"/>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,8,20,0"><StackPanel>
<TextBlock Text="任务内容" Style="{StaticResource FieldLabel}"/>
<ui:TextBox x:Name="TitleInput" Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="准备做什么？" MaxLength="100" Style="{StaticResource GlassInput}"/>
<TextBlock Text="{Binding Feedback}" Style="{StaticResource ValidationMessage}"/>
<TextBlock Text="备注（选填）" Style="{StaticResource FieldLabel}"/>
<ui:TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="补充需要记住的细节" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="120" MaxLength="4000" VerticalScrollBarVisibility="Auto" Style="{StaticResource GlassInput}"/>
<TextBlock Text="截止日期（选填）" Style="{StaticResource FieldLabel}"/>
<DockPanel><ui:Button DockPanel.Dock="Right" Icon="{icons:Iconfont Close}" Style="{StaticResource QuietButton}" Click="ClearEditorDate" ToolTip="清除截止日期"/><DatePicker x:Name="DuePicker" SelectedDate="{Binding DueDate}" DateValidationError="InvalidDate" SelectedDateChanged="DateChanged"/></DockPanel>
<TextBlock x:Name="DateFeedback" Style="{StaticResource ValidationMessage}"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="优先级" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PriorityOptions}" SelectedIndex="{Binding Priority}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="所属清单" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Lists}" SelectedItem="{Binding List}"/></StackPanel></Grid>
<TextBlock Text="子任务（选填）" Style="{StaticResource FieldLabel}"/>
<ItemsControl ItemsSource="{Binding Steps}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,6"><ui:Button DockPanel.Dock="Right" Icon="{icons:Iconfont Delete,Size=14}" Command="{Binding DataContext.RemoveStepCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Foreground="#C54545" ToolTip="移除子任务"/><CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<DockPanel><ui:Button DockPanel.Dock="Right" Icon="{icons:Iconfont Add}" Command="{Binding AddStepCommand}" Style="{StaticResource QuietButton}" ToolTip="添加子任务"/><ui:TextBox Text="{Binding StepTitle,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="添加一个小步骤…" MaxLength="80" Style="{StaticResource GlassInput}"><ui:TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddStepCommand}"/></ui:TextBox.InputBindings></ui:TextBox></DockPanel>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16"><ui:Button Content="取消" IsCancel="True" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><ui:Button x:Name="SaveButton" Content="保存任务" Click="SaveClick" Style="{StaticResource PrimaryGlassButton}"/></StackPanel>
</Grid></ui:FluentWindow>
